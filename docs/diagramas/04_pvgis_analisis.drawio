<mxfile host="app.diagrams.net" type="device"><diagram id="nb04-analysis-final" name="Página-1"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1123" pageHeight="1587" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Notebook 04 · Análisis PVGIS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=22;fontStyle=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="180" y="20" width="763" height="40" as="geometry" /></mxCell><mxCell id="base" value="&lt;b&gt;Resultados PVGIS validados&lt;/b&gt;&lt;br&gt;24 puntos · 288 registros mensuales · 24 JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="316" y="80" width="490" height="75" as="geometry" /></mxCell><mxCell id="annual" value="&lt;b&gt;Producción fotovoltaica anual&lt;/b&gt;&lt;br&gt;kWh/kWp·año&lt;br&gt;mayor valor = mayor potencial" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="65" y="225" width="285" height="105" as="geometry" /></mxCell><mxCell id="monthly" value="&lt;b&gt;Producción mensual&lt;/b&gt;&lt;br&gt;12 meses por punto&lt;br&gt;variabilidad estacional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="419" y="225" width="285" height="105" as="geometry" /></mxCell><mxCell id="support" value="&lt;b&gt;Variables descriptivas del NB04&lt;/b&gt;&lt;br&gt;irradiación anual · pérdidas totale