eta y requiere estudios técnicos posteriores" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;align=center;verticalAlign=middle;fontSize=13;arcSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="1260" width="900" height="125" as="geometry" /></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="A" target="B"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;exitX=0.3000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="B" target="C"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="350" /><mxPoint x="340" y="350" /></Array></mxGeometry></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;exitX=0.7000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="B" target="F"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="350" /><mxPoint x="1060" y="350" /></Array></mxGeometry></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.1;exitX=0.1923;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="F" target="G1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="575" /><mxPoint x="230" y="575" /></Array></mx