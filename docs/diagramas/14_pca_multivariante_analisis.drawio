<mxfile host="app.diagrams.net" version="24.7.17" type="device"><diagram id="nb14-analysis" name="Análisis NB14"><mxGraphModel dx="1400" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1440" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Notebook 14 · Análisis e interpretación del PCA" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="250" y="20" width="670" height="50" as="geometry" /></mxCell><mxCell id="A" value="PCA definitivo&lt;br&gt;&lt;b&gt;3 componentes · 74,54 % de varianza explicada&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.25;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="330" y="100" width="510" height="80" as="geometry" /></mxCell><mxCell id="B" value="&lt;b&gt;PC1 · 32,99 %&lt;/b&gt;&lt;br&gt;Infraestructuras territoriales, logística y condiciones fotovoltaicas&lt;br&gt;&lt;br&gt;Logística 20,5 % · PVGIS 18,0 %&lt;br&gt;Eléctrica 15,8 % · Digital 14,3 %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.25;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1"><mxGeometry x="30" y="250" width="340" height="135" as="geometry" /></mxCell><mxCell id="C" value="&lt;b&gt;PC2 · 27,59 %&lt;/b&gt;&lt;br&gt;Dimensión climática, solar y digital&lt;br&gt;&lt;br&gt;Climática 28,3 % · Digital 15,2 %&lt;br&gt;PVGIS 14,3 %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.25;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1"><mxGeometry x="415" y="250" width="340" height="135" as="geometry" /></mxCell><mxCell id="D" value="&lt;b&gt;PC3 · 13,95 %&lt;/b&gt;&lt;br&gt;Dimensión ambiental y socioeconómica&lt;br&gt;&lt;br&gt;Ambiental 30,0 %&lt;br&gt;Socioeconómica 20,9 %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.25;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1"><mxGeometry x="800" y="250" width="340" height="135" as="geometry" /></mxCell><mxCell id="E" value="&lt;b&gt;Extremos PC1&lt;/b&gt;&lt;br&gt;+ Grande Lisboa · País Vasco · Península de Setúbal&lt;br&gt;− Extremadura · Alentejo · Castilla-La Mancha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.25;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1"><mxGeometry x="30" y="455" width="340" height="105" as="geometry" /></mxCell><mxCell id="F" value="&lt;b&gt;Extremos PC2&lt;/b&gt;&lt;br&gt;+ Grande Lisboa · Península de Setúbal · Algarve&lt;br&gt;− Cantabria · Principado de Asturias · Navarra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.25;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1"><mxGeometry x="415" y="455" width="340" height="105" as="geometry" /></mxCell><mxCell id="G" value="&lt;b&gt;Extremos PC3&lt;/b&gt;&lt;br&gt;+ Madrid · Murcia · Comunitat Valenciana&lt;br&gt;− Oeste e Vale do Tejo · Centro (PT) · Galicia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.25;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1"><mxGeometry x="800" y="455" width="340" height="105" as="geometry" /></mxCell><mxCell id="H" value="Contraste con Isolation Forest&lt;br&gt;Grande Lisboa y Península de Setúbal destacan en PC1 y PC2 · Madrid en PC3&lt;br&gt;Algarve destaca en PC2, pero no es singular en el modelo base" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.25;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1"><mxGeometry x="330" y="650" width="510" height="95" as="geometry" /></mxCell><mxCell id="I" value="Sensibilidad al retirar temporalmente Grande Lisboa y Península de Setúbal&lt;br&gt;&lt;b&gt;Varianza acumulada: 74,54 % → 72,76 %&lt;/b&gt;&lt;br&gt;Correlación absoluta de cargas: PC1 0,887 · PC2 0,571 · PC3 0,619" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.25;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1"><mxGeometry x="330" y="805" width="510" height="105" as="geometry" /></mxCell><mxCell id="J" value="Lectura de estabilidad&lt;br&gt;&lt;b&gt;PC1 mantiene una estructura bastante estable.&lt;/b&gt;&lt;br&gt;PC2 y PC3 son más sensibles y se interpretan con mayor cautela." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.25;align=center;verticalAlign=middle;fontSize=14;" parent="1" vertex="1"><mxGeometry x="330" y="970" width="510" height="95" as="geometry" /></mxCell><mxCell id="K" value="Decisión final&lt;br&gt;&lt;b&gt;Se mantienen los 22 territorios.&lt;/b&gt;&lt;br&gt;PC1, PC2 y PC3 se conservan como entrada del Notebook 15." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.25;align=center;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="330" y="1125" width="510" height="90" as="geometry" /></mxCell><mxCell id="N3" value="Las puntuaciones PCA describen posición multivariante.&lt;br&gt;No son un ranking de idoneidad ni determinan los pesos del IIT-CPD." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;dashed=1;align=center;verticalAlign=middle;fontSize=12;" parent="1" vertex="1"><mxGeometry x="330" y="1270" width="510" height="80" as="geometry" /></mxCell><mxCell id="eA1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.25;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A" target="B"><mxGeometry